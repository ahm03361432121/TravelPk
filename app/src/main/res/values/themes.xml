<resources>
    <style name="Theme.TravelPk" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryDark">@color/brand_blue_dark</item>
        <item name="colorSecondary">@color/brand_blue</item>
        <item name="colorAccent">@color/brand_blue</item>
        <item name="android:statusBarColor">@color/brand_blue</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.TravelPk.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.TravelPk</item>
    </style>
</resources>
